AIPACE_HOST=0.0.0.0
AIPACE_PORT=8036
AIPACE_REQUEST_TIMEOUT=20
AIPACE_CODEX_TIMEOUT=20
AIPACE_HISTORY_PATH=~/.local/share/aipace/usage-history.sqlite3
# Set to 0 to disable periodic collection.
AIPACE_REFRESH_MINUTES=5
# AGY_OAUTH_TOKEN_FILE=/path/to/antigravity-oauth-token

# Apply usable banked resets before expiry; enable in only the Mac app or server.
AIPACE_AUTO_APPLY_RESETS=false
# Minutes before expiry to apply a reset (clamped to 1–60).
AIPACE_AUTO_APPLY_LEAD_MINUTES=5
